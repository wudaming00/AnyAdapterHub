        },
        "tv_mute": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_set_input": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_sound_output": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_screen": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_power": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "temporary-observe": {
          "$ref": "#/$defs/privilegedVerification"
        }
      }
    }
  },
  "$defs": {
    "ordinaryVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "unsupported",
            "unverified"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^docs/evidence/[a-z0-9]+(?:-[a-z0-9]+)*\\.md#[a-z0-9]+(?:[-_][a-z0-9]+)*$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "verified",
                  "unsupported"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "privilegedVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence",
        "optInRequired"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "unsupported",
            "unverified"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^docs/evidence/[a-z0-9]+(?:-[a-z0-9]+)*\\.md#[a-z0-9]+(?:[-_][a-z0-9]+)*$"
          }
        },
        "optInRequired": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "verified",
                  "unsupported"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capabilityIds": {
            "contains": {
              "const": "tv_status"
            }
          }
        },
        "required": [
