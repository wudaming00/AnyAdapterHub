{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed device profile data",
  "description": "Profiles describe compatibility and evidence; they do not grant permissions, install adapters, or enable capabilities. Runtime validation also enforces size, depth, JSON-only objects and forbidden keys.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "vendor",
    "model",
    "firmware",
    "adapter",
    "capabilityIds",
    "verification"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "vendor": {
      "const": "LG"
    },
    "model": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "firmware": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\d{1,3}(?:\\.\\d{1,3}){2}(?:-\\d{1,3})?$"
      }
    },
    "adapter": {
      "enum": [
        "lg-webos"
      ]
    },
    "capabilityIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "uniqueItems": true,
      "items": {
        "enum": [
          "tv_status",
          "tv_apps",
          "tv_keyboard_state",
          "tv_screenshot",
          "tv_launch",
          "tv_launch_content",
          "tv_open_url",
          "tv_play_url",
          "tv_dlna_play",
          "tv_dlna_status",
          "tv_dlna_media",
          "tv_cast_file",
          "tv_type_text",
          "tv_key",
          "tv_pointer_move",
          "tv_pointer_click",
          "tv_pointer_scroll",
          "tv_media",
          "tv_set_volume",
          "tv_mute",
          "tv_set_input",
          "tv_sound_output",
          "tv_screen",
          "tv_power",
          "temporary-observe"
        ]
      }
    },
    "verification": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 25,
      "additionalProperties": false,
      "properties": {
        "tv_status": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_apps": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_keyboard_state": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_screenshot": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_launch": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_launch_content": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_open_url": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_play_url": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_dlna_play": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_dlna_status": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_dlna_media": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_cast_file": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_type_text": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_key": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_pointer_move": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_pointer_click": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_pointer_scroll": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_media": {
          "$ref": "#/$defs/ordinaryVerification"
        },
        "tv_set_volume": {
