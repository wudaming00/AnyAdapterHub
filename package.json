{
  "name": "anyadapter-hub",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A local device hub for agents: explicit permissions, observable outcomes, community adapters",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "discover": "node discover.mjs",
    "hub": "node device-hub.mjs",
    "test": "node --test",
    "check:profiles": "node scripts/check-profiles.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm test && npm run check:profiles && npm run check:package && npm run check:public",
    "check:public": "node scripts/check-public.mjs",
    "adapter:lg:install": "npm install --no-save --package-lock=false --ignore-scripts ws@8.22.0"
  },
  "peerDependencies": {
    "ws": "8.22.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "license": "MIT AND GPL-3.0-or-later",
  "files": [
    "lib/",
    "device-hub.mjs",
    "mcp-tv.mjs",
    "lg-tv.mjs",
    "discover.mjs",
    "inspect-public.mjs",
    "profiles/",
    "schema/",
    "privileged-probe/bridge-observe.html",
    "privileged-probe/capture-cleanup.js",
    "scripts/",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "third_party/lgtv2-pairing.json",
    "third_party/lgtv2-LICENSE.txt",
    "third_party/provenance.json",
    "README.zh-CN.md",
    "optional/ecovacs/worker.py",
    "optional/ecovacs/test_worker.py",
    "optional/ecovacs/requirements.txt",
    "optional/ecovacs/LICENSE",
    "optional/ecovacs/README.md",
    "optional/ecovacs/provenance.json",
    "optional/lg-webos/README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wudaming00/AnyAdapterHub.git"
  },
  "bugs": {
    "url": "https://github.com/wudaming00/AnyAdapterHub/issues"
  },
  "homepage": "https://github.com/wudaming00/AnyAdapterHub#readme"
}
